msgid "УРОВЕНЬ %d"
msgstr "SEVİYE %d"

msgid "Осталось блоков: %d"
msgstr "Kalan blok: %d"

msgid "Отлично!"
msgstr "Harika!"

msgid "Супер!"
msgstr "Süper!"

msgid "Невероятно!"
msgstr "İnanılmaz!"

msgid "Тупик: так поле не заполнить. Отмени ход"
msgstr "Çıkmaz: tahta artık dolmaz. Hamleyi geri al"

msgid "Нет ходов! Отмени ошибку"
msgstr "Hamle yok! Hatayı geri al"

msgid "Всё ещё тупик — отмени ещё ход"
msgstr "Hâlâ çıkmaz — bir hamle daha geri al"

msgid "Подсказка откроется после просмотра рекламы"
msgstr "İpucu için reklamı izle"

msgid "Сначала отмени ошибочный ход"
msgstr "Önce hatalı hamleyi geri al"

msgid "Подсказка: убраны неверные блоки (%d)"
msgstr "İpucu: hatalı bloklar kaldırıldı (%d)"

msgid "Число — это размер блока. Перетащи блок на его число"
msgstr "Sayı, bloğun boyutudur. Her bloğu kendi sayısına sürükle"

msgid "Нажми на блок, чтобы повернуть его"
msgstr "Döndürmek için bloğa dokun"

msgid "В каждом блоке — ровно одно число"
msgstr "Her blok tam olarak bir sayıyı kaplar"

msgid "Блок накрывает одно число, и его размер равен этому числу"
msgstr "Blok tek bir sayıyı kaplar ve boyutu o sayıya eşittir"

msgid "Блоки не должны накладываться"
msgstr "Bloklar üst üste binemez"

msgid "В блоке должно быть ровно одно число"
msgstr "Blok tam olarak bir sayıyı kaplamalı"

msgid "Здесь нужен блок из %d клеток"
msgstr "Buraya %d hücrelik bir blok gerekir"

msgid "Так остальные блоки не поместятся"
msgstr "O zaman diğer bloklar sığmaz"

msgid "Эта клетка занята с самого начала"
msgstr "Bu hücre baştan beri dolu"

msgid "Цветную клетку накрывает только блок того же цвета"
msgstr "Renkli hücreye yalnızca aynı renkte blok konur"

msgid "Белые плитки — препятствия: на них блок не встанет"
msgstr "Beyaz karolar engeldir: üzerlerine blok konmaz"

msgid "Серый блок закреплён: строй вокруг него"
msgstr "Gri blok sabit: etrafına yerleştir"

msgid "«?» — размер неизвестен: подойдёт любой блок, но решение одно"
msgstr "“?” boyutu gizler: her blok sığabilir ama tek bir çözüm var"

